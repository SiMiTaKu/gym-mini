# FYI: Gitでのファイル扱いを統一するための設定

# すべてのテキストファイルは自動改行変換
* text=auto

# GDScript（Godot専用スクリプト）
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf

# Markdownとドキュメント
*.md text eol=lf
*.txt text eol=lf

# 画像ファイル（バイナリ扱い）
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.ico binary
*.svg text

# 音声ファイル（バイナリ扱い）
*.wav binary
*.mp3 binary
*.ogg binary

# フォント（バイナリ扱い）
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# NOTE: 大きなファイルは将来的にGit LFSで管理することを検討
